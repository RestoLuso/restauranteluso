      <a href="#menu" style="color:#fff;margin:0 10px;text-decoration:none;">Menu</a>
      <a href="#contact" style="color:#fff;margin:0 10px;text-decoration:none;">Contact</a>
    </nav>
  </div>
</header>

<!-- FOOTER -->
